{
  "name": "eco-campus",
  "private": true,
  "version": "1.0.0",
  "description": "Campus e-waste collection system monorepo",
  "workspaces": [
    "apps/api",
    "apps/web-admin"
  ],
  "scripts": {
    "dev": "npm run dev -w apps/api & npm run dev -w apps/web-admin",
    "dev:api": "npm run dev -w apps/api",
    "dev:web": "npm run dev -w apps/web-admin",
    "build": "npm run build -w apps/api && npm run build -w apps/web-admin"
  },
  "dependencies": {
    "mongodb": "^7.1.1"
  }
}
